# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Webhook ---
# Path the webhook is served on (must match what's registered with Telegram).
WEBHOOK_PATH=/webhook
# Secret checked against Telegram's X-Telegram-Bot-Api-Secret-Token header.
# Generate a random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-to-a-random-value
# Public HTTPS URL of this service, e.g. https://your-app.example.com
# When set, the app registers the webhook with Telegram automatically on startup.
# When unset, webhook registration is assumed to happen externally (e.g. via a deploy script).
WEBHOOK_URL=
WEBHOOK_MAX_PAYLOAD_BYTES=1000000

# --- AI feature (optional) ---
# Master switch. When false, no Gemini key/client is required and the AI
# handler is never registered — only the normal bot runs.
AI_ENABLED=false

DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# --- Security ---
# Comma-separated Telegram user IDs allowed to use the bot. Leave empty to allow everyone.
ALLOWED_TELEGRAM_USER_IDS=
# Comma-separated Telegram user IDs with admin privileges.
ADMIN_TELEGRAM_USER_IDS=

RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_MESSAGE_LENGTH=4000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
